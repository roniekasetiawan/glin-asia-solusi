---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${basePath}${path}`;
---

<footer class="bg-[#071633] py-12 text-white">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 md:grid-cols-[1.1fr_0.9fr_0.9fr] lg:px-8">
    <div>
      <div class="flex items-center gap-3">
        <span class="flex h-11 w-11 items-center justify-center rounded bg-djp-gold text-lg font-extrabold text-djp-deep">GA</span>
        <span>
          <span class="block text-lg font-extrabold">PT. Glin Asia Solusi</span>
          <span class="block text-xs font-semibold uppercase text-slate-300">Corporate Tax Advisory</span>
        </span>
      </div>
      <p class="mt-5 max-w-md text-sm leading-7 text-slate-300">
        Layanan profesional untuk kebutuhan administrasi keuangan, pembukuan, dan perpajakan perusahaan.
      </p>
    </div>
    <div>
      <h3 class="text-sm font-extrabold uppercase text-djp-gold">Services</h3>
      <ul class="mt-4 space-y-3 text-sm text-slate-300">
        <li><a href={url('/services/accounting-service/')} class="hover:text-djp-gold">Accounting Service</a></li>
        <li><a href={url('/services/tax-service/')} class="hover:text-djp-gold">Tax Service</a></li>
        <li><a href={url('/services/finance-assistant/')} class="hover:text-djp-gold">Finance Assistant</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-extrabold uppercase text-djp-gold">Contact Info</h3>
      <ul class="mt-4 space-y-3 text-sm text-slate-300">
        <li>Jakarta Selatan, DKI Jakarta</li>
        <li>halo@glinasiasolusi.id</li>
        <li>wa.me/xxx</li>
      </ul>
    </div>
  </div>
  <div class="mx-auto mt-10 flex max-w-7xl flex-col gap-4 border-t border-white/10 px-5 pt-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between lg:px-8">
    <p>&copy; <span id="year"></span> PT. Glin Asia Solusi. All rights reserved.</p>
    <div class="flex gap-4">
      <a href={url('/about/')} class="hover:text-djp-gold">About</a>
      <a href={url('/contact/')} class="hover:text-djp-gold">Contact</a>
      <a href={url('/blog/')} class="hover:text-djp-gold">Blog</a>
    </div>
  </div>
</footer>
