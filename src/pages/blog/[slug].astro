---
import Layout from '../../layouts/Layout.astro';
import { blogPosts } from '../../data/blogPosts';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
---

<Layout title={`${post.title} | PT. Glin Asia Solusi`} description={post.description} canonicalPath={`/blog/${post.slug}/`} active="blog">
  <article>
    <section class="page-hero">
      <div class="mx-auto max-w-4xl px-5 py-16 text-white sm:py-20 lg:px-8">
        <p class="text-sm font-extrabold uppercase text-djp-gold">{post.category}</p>
        <h1 class="mt-5 text-4xl font-extrabold leading-tight sm:text-5xl">{post.title}</h1>
        <p class="mt-5 leading-8 text-slate-200">{post.description}</p>
      </div>
    </section>
    <section class="bg-white py-16">
      <div class="article-body mx-auto max-w-3xl px-5 lg:px-8">
        {post.body.map((paragraph) => <p class="mb-6">{paragraph}</p>)}
        <div class="mt-10 rounded-lg bg-djp-soft p-6">
          <h2 class="mt-0 text-2xl font-extrabold text-djp-deep">Butuh bantuan terkait topik ini?</h2>
          <p class="mt-3 leading-7 text-slate-600">Diskusikan kondisi perusahaan Anda agar kami dapat membantu memetakan langkah awal yang paling tepat.</p>
          <a href="#" data-wa-message={`Halo PT. Glin Asia Solusi, saya ingin konsultasi terkait artikel: ${post.title}.`} class="mt-5 inline-flex rounded bg-djp-gold px-6 py-4 text-sm font-bold text-djp-deep">Diskusikan via WhatsApp</a>
        </div>
      </div>
    </section>
  </article>
</Layout>
