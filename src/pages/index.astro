---
import Layout from '../layouts/Layout.astro';
import CTAForm from '../components/CTAForm.astro';
import { blogPosts } from '../data/blogPosts';
---

<Layout
  title="PT. Glin Asia Solusi | Konsultan Pajak dan Pembukuan Perusahaan"
  description="PT. Glin Asia Solusi membantu perusahaan di Indonesia menata pembukuan, pelaporan pajak, finance assistant, transfer pricing, dan pendampingan pemeriksaan pajak."
  canonicalPath="/"
>
  <section class="hero hero-interactive">
    <div class="hero-glow hero-glow-a"></div>
    <div class="hero-glow hero-glow-b"></div>
    <div class="hero-orbit hero-orbit-one"></div>
    <div class="hero-orbit hero-orbit-two"></div>
    <div class="hero-content-layer mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 sm:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:px-8 lg:py-24">
      <div class="hero-copy">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-djp-gold/40 bg-white/10 px-4 py-2 text-xs font-bold uppercase text-djp-gold shadow-sm backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-djp-gold"></span>
          PT. Glin Asia Solusi
        </div>
        <h1 class="max-w-4xl text-4xl font-extrabold leading-tight text-white sm:text-5xl lg:text-6xl">Kantor Konsultan Akuntansi & Pajak untuk Perusahaan Anda</h1>
        <p class="mt-6 max-w-2xl text-base leading-8 text-slate-200 sm:text-lg">Kami membantu bisnis menata pembukuan, pajak, administrasi finance, dan dokumen pendukung agar proses operasional lebih rapi, patuh, dan siap diaudit.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#" data-wa-message="Halo PT. Glin Asia Solusi, saya ingin konsultasi sekarang untuk kebutuhan akuntansi dan pajak perusahaan." class="hero-cta-primary inline-flex items-center justify-center gap-2 rounded bg-djp-gold px-6 py-4 text-sm font-bold text-djp-deep shadow-lg shadow-black/20 transition hover:bg-djp-goldDark">Konsultasikan Sekarang <i data-lucide="arrow-right" class="h-4 w-4"></i></a>
          <a href="/services/" class="hero-cta-secondary inline-flex items-center justify-center gap-2 rounded border border-white/30 px-6 py-4 text-sm font-bold text-white transition hover:border-djp-gold hover:bg-white/10"><i data-lucide="layers-3" class="h-4 w-4"></i> Lihat Layanan</a>
        </div>
      </div>

      <div class="hero-visual">
      <div class="premium-panel hero-tilt rounded-lg p-5 sm:p-7" data-tilt-card>
        <div class="flex items-center justify-between border-b border-slate-200 pb-5">
          <div>
            <p class="text-sm font-bold text-djp-navy">Tax & Finance Advisory Desk</p>
            <p class="mt-1 text-xs text-slate-500">Pembukuan, pajak, dan dokumen pendukung</p>
          </div>
          <span class="rounded bg-djp-gold px-3 py-1 text-xs font-bold text-djp-deep">Consult First</span>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
          <a href="/services/accounting-service/" class="hero-mini-card rounded border border-slate-200 bg-white p-4"><p class="text-lg font-extrabold text-djp-deep">Accounting</p><p class="mt-2 text-xs font-semibold text-slate-500">Pembukuan</p></a>
          <a href="/services/tax-service/" class="hero-mini-card rounded border border-slate-200 bg-white p-4"><p class="text-lg font-extrabold text-djp-deep">Tax</p><p class="mt-2 text-xs font-semibold text-slate-500">Pelaporan Pajak</p></a>
          <a href="/services/finance-assistant/" class="hero-mini-card rounded border border-slate-200 bg-white p-4"><p class="text-lg font-extrabold text-djp-deep">Finance</p><p class="mt-2 text-xs font-semibold text-slate-500">Administrasi</p></a>
        </div>
        <div class="mt-6 rounded bg-djp-deep p-5 text-white">
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded bg-djp-gold text-djp-deep">
              <i data-lucide="sparkles" class="h-6 w-6"></i>
            </div>
            <div>
              <p class="font-bold">Smart Workflow Review</p>
              <p class="mt-2 text-sm leading-6 text-slate-200">Pemetaan awal atas pembukuan, pajak, dan dokumen finance sebelum rekomendasi kerja disusun.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="hero-floating-note hidden md:flex">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded bg-djp-gold text-djp-deep">
          <i data-lucide="route" class="h-5 w-5"></i>
        </div>
        <div>
          <p class="text-xs font-extrabold uppercase text-djp-gold">Advisory Path</p>
          <p class="mt-1 text-sm font-semibold text-white">Bookkeeping -> Tax Review -> Reporting</p>
        </div>
      </div>
      </div>

      <div class="hero-lower-strip lg:col-span-2">
        <div class="hero-process-card">
          <div class="flex h-11 w-11 items-center justify-center rounded bg-djp-gold text-djp-deep">
            <i data-lucide="receipt-text" class="h-5 w-5"></i>
          </div>
          <div>
            <p class="text-sm font-extrabold text-white">Tax Document Intake</p>
            <p class="mt-1 text-xs text-slate-300">Invoice, faktur pajak, bukti potong, dan bank statement.</p>
          </div>
        </div>
        <div class="hero-process-card">
          <div class="flex h-11 w-11 items-center justify-center rounded bg-white/10 text-djp-gold">
            <i data-lucide="keyboard" class="h-5 w-5"></i>
          </div>
          <div>
            <p class="text-sm font-extrabold text-white">Advisor Review in Progress</p>
            <p class="mt-1 text-xs text-slate-300"><span class="typing-dots">Mengetik rekomendasi awal</span></p>
          </div>
        </div>
        <div class="hero-receipt-stack" aria-hidden="true">
          <div class="receipt-paper receipt-paper-back"></div>
          <div class="receipt-paper">
            <div class="receipt-header">
              <span>VAT RECEIPT</span>
              <strong>PPN</strong>
            </div>
            <div class="receipt-line wide"></div>
            <div class="receipt-line"></div>
            <div class="receipt-line short"></div>
            <div class="receipt-row"><span>DPP</span><b>Rp 128.400.000</b></div>
            <div class="receipt-row"><span>PPN</span><b>Rp 14.124.000</b></div>
            <div class="receipt-total"><span>Status</span><b>Ready to File</b></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-100 bg-djp-soft py-8">
    <div class="mx-auto grid max-w-7xl gap-3 px-5 sm:grid-cols-2 lg:grid-cols-4 lg:px-8">
      <div class="card flex items-center gap-3 px-4 py-5"><i data-lucide="lock-keyhole" class="h-5 w-5 text-djp-navy"></i><span class="text-sm font-bold">Confidential Advisory</span></div>
      <div class="card flex items-center gap-3 px-4 py-5"><i data-lucide="file-check-2" class="h-5 w-5 text-djp-navy"></i><span class="text-sm font-bold">Documented Review</span></div>
      <div class="card flex items-center gap-3 px-4 py-5"><i data-lucide="scan-search" class="h-5 w-5 text-djp-navy"></i><span class="text-sm font-bold">Risk-Based Assessment</span></div>
      <div class="card flex items-center gap-3 px-4 py-5"><i data-lucide="workflow" class="h-5 w-5 text-djp-navy"></i><span class="text-sm font-bold">CoreTax Readiness</span></div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-3xl">
        <p class="kicker">Solusi Akuntansi & Pajak Anda</p>
        <div class="gold-rule mt-3"></div>
        <h2 class="mt-5 text-3xl font-extrabold text-djp-deep sm:text-4xl">Layanan profesional untuk proses keuangan yang lebih nyaman.</h2>
        <p class="mt-4 leading-7 text-slate-600">Kenyamanan bisnis perusahaan bergantung pada pembukuan, administrasi, dan kepatuhan pajak yang tertata.</p>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        <a href="/services/accounting-service/" class="card p-7"><span class="text-sm font-extrabold text-djp-gold">01.</span><i data-lucide="book-open-check" class="mt-6 h-8 w-8 text-djp-navy"></i><h3 class="mt-5 text-xl font-extrabold text-djp-deep">Accounting Service</h3><p class="mt-3 text-sm leading-7 text-slate-600">Jasa pembukuan, laporan keuangan, rekonsiliasi, dan review administrasi transaksi.</p></a>
        <a href="/services/tax-service/" class="card p-7"><span class="text-sm font-extrabold text-djp-gold">02.</span><i data-lucide="receipt-text" class="mt-6 h-8 w-8 text-djp-navy"></i><h3 class="mt-5 text-xl font-extrabold text-djp-deep">Tax Service</h3><p class="mt-3 text-sm leading-7 text-slate-600">Hitung, bayar, lapor pajak masa dan tahunan dengan proses yang lebih tertib.</p></a>
        <a href="/services/finance-assistant/" class="card p-7"><span class="text-sm font-extrabold text-djp-gold">03.</span><i data-lucide="folder-cog" class="mt-6 h-8 w-8 text-djp-navy"></i><h3 class="mt-5 text-xl font-extrabold text-djp-deep">Finance Assistant</h3><p class="mt-3 text-sm leading-7 text-slate-600">Asistensi administrasi finance, arsip dokumen, pembayaran, dan data pendukung.</p></a>
      </div>
    </div>
  </section>

  <section class="bg-djp-soft py-16 sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[0.8fr_1.2fr] lg:px-8">
      <div><p class="kicker">Business Problems</p><div class="gold-rule mt-3"></div><h2 class="mt-5 text-3xl font-extrabold text-djp-deep sm:text-4xl">Masalah yang sering menghambat pengelolaan keuangan perusahaan.</h2></div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div class="card p-7"><h3 class="font-extrabold text-djp-deep">Pembukuan Belum Tertata</h3><p class="mt-3 text-sm leading-7 text-slate-600">Transaksi sulit ditelusuri, rekonsiliasi terlambat, dan laporan belum siap untuk review manajemen.</p></div>
        <div class="card p-7"><h3 class="font-extrabold text-djp-deep">Pelaporan Pajak Membingungkan</h3><p class="mt-3 text-sm leading-7 text-slate-600">Perhitungan, bukti potong, pembayaran, dan pelaporan membutuhkan kontrol yang disiplin.</p></div>
        <div class="card p-7"><h3 class="font-extrabold text-djp-deep">Dokumen Tidak Siap Saat Dibutuhkan</h3><p class="mt-3 text-sm leading-7 text-slate-600">Dokumen pendukung tercecer membuat proses pemeriksaan dan audit internal menjadi berat.</p></div>
        <div class="card p-7"><h3 class="font-extrabold text-djp-deep">Tim Internal Butuh Dukungan</h3><p class="mt-3 text-sm leading-7 text-slate-600">Kami membantu pekerjaan administrasi rutin agar tim finance dapat fokus pada keputusan bisnis.</p></div>
      </div>
    </div>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div><p class="kicker">Blog & Insights</p><div class="gold-rule mt-3"></div><h2 class="mt-5 text-3xl font-extrabold text-djp-deep sm:text-4xl">Insight untuk akuntansi dan pajak perusahaan.</h2></div>
        <a href="/blog/" class="inline-flex items-center gap-2 text-sm font-bold text-djp-navy hover:text-djp-deep">Lihat Blog <i data-lucide="arrow-right" class="h-4 w-4"></i></a>
      </div>
      <div class="mt-10 grid gap-5 lg:grid-cols-3">
        {blogPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} class="card p-6">
            <span class="rounded bg-djp-gold/20 px-3 py-1 text-xs font-bold text-djp-deep">{post.category}</span>
            <h3 class="mt-5 text-lg font-extrabold text-djp-deep">{post.title}</h3>
            <p class="mt-4 text-sm leading-7 text-slate-600">{post.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-djp-deep py-16 text-white sm:py-20">
    <div class="mx-auto grid max-w-7xl gap-10 px-5 lg:grid-cols-[0.85fr_1.15fr] lg:px-8">
      <div><p class="text-sm font-extrabold uppercase text-djp-gold">Change Starts with a Single Step</p><div class="gold-rule mt-3"></div><h2 class="mt-5 text-3xl font-extrabold leading-tight sm:text-4xl">Diskusikan masalah pembukuan dan perpajakan Anda.</h2><p class="mt-5 leading-8 text-slate-200">Kirim ringkasan kebutuhan. Form akan membuka WhatsApp dengan pesan yang sudah tersusun.</p></div>
      <CTAForm />
    </div>
  </section>
</Layout>
