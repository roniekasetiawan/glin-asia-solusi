---
import Layout from '../../layouts/Layout.astro';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${basePath}${path}`;
---

<Layout title="Services | PT. Glin Asia Solusi" description="Layanan PT. Glin Asia Solusi untuk accounting service, tax service, finance assistant, transfer pricing, dan pendampingan pemeriksaan pajak perusahaan." canonicalPath="/services/" active="services">
  <section class="page-hero">
    <div class="mx-auto max-w-7xl px-5 py-16 text-white sm:py-20 lg:px-8">
      <p class="text-sm font-extrabold uppercase text-djp-gold">Services</p>
      <h1 class="mt-5 max-w-4xl text-4xl font-extrabold leading-tight sm:text-5xl">Solusi akuntansi, pajak, dan finance assistant untuk perusahaan.</h1>
      <p class="mt-5 max-w-2xl leading-8 text-slate-200">Pilih layanan sesuai kondisi bisnis: pembukuan yang perlu dirapikan, pajak yang harus dilaporkan tepat waktu, atau administrasi finance yang membutuhkan dukungan rutin.</p>
    </div>
  </section>
  <section class="bg-white py-16 sm:py-20">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-3">
        <a href={url('/services/accounting-service/')} class="card p-8"><span class="text-sm font-extrabold text-djp-gold">01.</span><i data-lucide="book-open-check" class="mt-6 h-9 w-9 text-djp-navy"></i><h2 class="mt-6 text-2xl font-extrabold text-djp-deep">Accounting Service</h2><p class="mt-4 leading-7 text-slate-600">Pembukuan, laporan keuangan, rekonsiliasi bank, pencatatan transaksi, dan review dokumen akuntansi.</p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-djp-navy">Lihat detail <i data-lucide="arrow-right" class="h-4 w-4"></i></span></a>
        <a href={url('/services/tax-service/')} class="card p-8"><span class="text-sm font-extrabold text-djp-gold">02.</span><i data-lucide="receipt-text" class="mt-6 h-9 w-9 text-djp-navy"></i><h2 class="mt-6 text-2xl font-extrabold text-djp-deep">Tax Service</h2><p class="mt-4 leading-7 text-slate-600">Perhitungan, pembayaran, pelaporan pajak masa dan tahunan, review kepatuhan, serta dukungan pemeriksaan.</p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-djp-navy">Lihat detail <i data-lucide="arrow-right" class="h-4 w-4"></i></span></a>
        <a href={url('/services/finance-assistant/')} class="card p-8"><span class="text-sm font-extrabold text-djp-gold">03.</span><i data-lucide="folder-cog" class="mt-6 h-9 w-9 text-djp-navy"></i><h2 class="mt-6 text-2xl font-extrabold text-djp-deep">Finance Assistant</h2><p class="mt-4 leading-7 text-slate-600">Asistensi administrasi finance, arsip dokumen, payment tracking, dan persiapan data untuk akuntansi dan pajak.</p><span class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-djp-navy">Lihat detail <i data-lucide="arrow-right" class="h-4 w-4"></i></span></a>
      </div>
    </div>
  </section>
  <section class="bg-djp-deep py-14 text-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div><p class="text-sm font-extrabold uppercase text-djp-gold">Need Help?</p><h2 class="mt-3 text-3xl font-extrabold">Belum yakin layanan mana yang tepat?</h2><p class="mt-3 text-slate-200">Ceritakan kondisi perusahaan, kami bantu petakan kebutuhan awal.</p></div>
      <a href="#" data-wa-message="Halo PT. Glin Asia Solusi, saya ingin dibantu memilih layanan yang sesuai untuk perusahaan." class="inline-flex items-center justify-center gap-2 rounded bg-djp-gold px-6 py-4 text-sm font-bold text-djp-deep">Konsultasi via WhatsApp <i data-lucide="message-circle" class="h-4 w-4"></i></a>
    </div>
  </section>
</Layout>
